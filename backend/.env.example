# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored; this example file is safe to commit.

# NCBI E-utilities (PubMed)
# Free key: https://account.ncbi.nlm.nih.gov/settings/ -> "API Key Management"
# Optional, but raises the limit from 3 to 10 requests/second.
NCBI_API_KEY=
# NCBI asks every app to identify itself with a tool name and contact email.
NCBI_EMAIL=you@example.edu
NCBI_TOOL=healthcare-research-agent

# --- Optional tuning (defaults shown; uncomment to change) ---
# NCBI_TIMEOUT_SECONDS=15
# NCBI_MAX_RETRIES=2
# NCBI_RETRY_BACKOFF_SECONDS=1
# Leave unset to use NCBI's limit: 10/s with an API key, 3/s without.
# NCBI_REQUESTS_PER_SECOND=
# SEARCH_DEFAULT_RESULTS=20
# SEARCH_MIN_RESULTS=1
# SEARCH_MAX_RESULTS=100
# SEARCH_CANDIDATE_MULTIPLIER=3
# SEARCH_MAX_CANDIDATES=200
# RANKING_TITLE_WEIGHT=3
# RANKING_ABSTRACT_WEIGHT=1

# CORS: which browser origins may call the API.
# Development default: any http://localhost:<port> or 127.0.0.1:<port> is allowed.
# Production: turn that off and list your real frontend origin(s) as JSON.
# CORS_ALLOW_LOCAL_ORIGINS=false
# CORS_ORIGINS=["https://research.example.org"]
