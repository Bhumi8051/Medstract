# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored; this example file is safe to commit.

# NCBI E-utilities (PubMed)
# Free key: https://account.ncbi.nlm.nih.gov/settings/ -> "API Key Management"
# Optional, but raises the limit from 3 to 10 requests/second.
NCBI_API_KEY=
# NCBI asks every app to identify itself with a tool name and contact email.
NCBI_EMAIL=you@example.edu
NCBI_TOOL=healthcare-research-agent

# --- Optional tuning (defaults shown; uncomment to change) ---
# NCBI_TIMEOUT_SECONDS=15
# NCBI_MAX_RETRIES=2
# NCBI_RETRY_BACKOFF_SECONDS=1
# Leave unset to use NCBI's limit: 10/s with an API key, 3/s without.
# NCBI_REQUESTS_PER_SECOND=
# SEARCH_DEFAULT_RESULTS=20
# SEARCH_MIN_RESULTS=1
# SEARCH_MAX_RESULTS=100
# SEARCH_CANDIDATE_MULTIPLIER=3
# SEARCH_MAX_CANDIDATES=200
# RANKING_TITLE_WEIGHT=3
# RANKING_ABSTRACT_WEIGHT=1

# CORS: which browser origins may call the API.
# Development default: any http://localhost:<port> or 127.0.0.1:<port> is allowed.
# Production: turn that off and list your real frontend origin(s) as JSON.
# CORS_ALLOW_LOCAL_ORIGINS=false
# CORS_ORIGINS=["https://research.example.org"]

# --- Google Gemini (AI paper analysis) ---
# Get a key at https://aistudio.google.com/apikey. Keep it ONLY in backend/.env
# (git-ignored); never in frontend files, source code or chats.
# Without a key, search still works and analysis returns a clear 503 error.
# Note: on Gemini's free tier, Google may use prompts/responses to improve its products.
GEMINI_API_KEY=
# Model ID (see https://ai.google.dev/gemini-api/docs/models). Default:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_OUTPUT_TOKENS=8192

# --- PostgreSQL (accounts, preferences, saved searches) ---
# Local default (Homebrew PostgreSQL, your macOS user, no password):
# DATABASE_URL=postgresql+asyncpg://localhost/healthcare_research
# With credentials: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Tests use a separate database (its name must end in _test):
# TEST_DATABASE_URL=postgresql+asyncpg://localhost/healthcare_research_test

# --- Login sessions ---
# SESSION_TTL_DAYS=14
# Production (HTTPS): set SESSION_COOKIE_SECURE=true. If the frontend and API are
# on different sites, also set SESSION_COOKIE_SAMESITE=none (requires secure=true).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# Failed logins allowed per email within the window (seconds) before a pause:
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900
