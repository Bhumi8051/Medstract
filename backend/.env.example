# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored; this example file is safe to commit.

# NCBI E-utilities (PubMed)
# Free key: https://account.ncbi.nlm.nih.gov/settings/ -> "API Key Management"
# Optional, but raises the limit from 3 to 10 requests/second.
NCBI_API_KEY=
# NCBI asks every app to identify itself with a tool name and contact email.
NCBI_EMAIL=you@example.edu
NCBI_TOOL=healthcare-research-agent

# --- Optional tuning (defaults shown; uncomment to change) ---
# NCBI_TIMEOUT_SECONDS=15
# NCBI_MAX_RETRIES=2
# NCBI_RETRY_BACKOFF_SECONDS=1
# Leave unset to use NCBI's limit: 10/s with an API key, 3/s without.
# NCBI_REQUESTS_PER_SECOND=
# SEARCH_DEFAULT_RESULTS=20
# SEARCH_MIN_RESULTS=1
# SEARCH_MAX_RESULTS=100
# SEARCH_CANDIDATE_MULTIPLIER=3
# SEARCH_MAX_CANDIDATES=200
# RANKING_TITLE_WEIGHT=3
# RANKING_ABSTRACT_WEIGHT=1

# CORS: which browser origins may call the API.
# Development default: any http://localhost:<port> or 127.0.0.1:<port> is allowed.
# Production: turn that off and list your real frontend origin(s) as JSON.
# CORS_ALLOW_LOCAL_ORIGINS=false
# CORS_ORIGINS=["https://research.example.org"]

# --- Google Gemini (AI paper analysis) ---
# Get a key at https://aistudio.google.com/apikey. Keep it ONLY in backend/.env
# (git-ignored); never in frontend files, source code or chats.
# Without a key, search still works and analysis returns a clear 503 error.
# Note: on Gemini's free tier, Google may use prompts/responses to improve its products.
GEMINI_API_KEY=
# Model ID (see https://ai.google.dev/gemini-api/docs/models). Default:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_OUTPUT_TOKENS=8192

# --- PostgreSQL (accounts, preferences, saved searches) ---
# Local default (Homebrew PostgreSQL, your macOS user, no password):
# DATABASE_URL=postgresql+asyncpg://localhost/healthcare_research
# With credentials: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Tests use a separate database (its name must end in _test):
# TEST_DATABASE_URL=postgresql+asyncpg://localhost/healthcare_research_test

# --- Login sessions ---
# SESSION_TTL_DAYS=14
# Production (HTTPS): set SESSION_COOKIE_SECURE=true. If the frontend and API are
# on different sites, also set SESSION_COOKIE_SAMESITE=none (requires secure=true).
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# Failed logins allowed per email within the window (seconds) before a pause:
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Step B security limits ---
# Gemini analyses: login required. Daily caps (UTC days), enforced atomically in PostgreSQL.
# Only successful analyses count; failed ones are refunded.
# AI_DAILY_LIMIT_PER_USER=20
# All users together (protects the project's free-tier quota). 0 = no overall cap.
# AI_DAILY_LIMIT_TOTAL=200
# Short-term brake per user against rapid clicking.
# AI_BURST_PER_MINUTE=5
#
# Per-IP limits on failed logins and on sign-ups.
# NOTE: these counters (and LOGIN_MAX_FAILURES above) live IN MEMORY. That suits the
# current single-process development setup, but they are NOT shared between multiple
# workers/servers and reset on restart. Use a shared store before scaling out.
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_IP_WINDOW_SECONDS=900
# REGISTER_IP_MAX_ATTEMPTS=5
# REGISTER_IP_WINDOW_SECONDS=3600
# Only set true behind a reverse proxy you control (otherwise X-Forwarded-For can be spoofed).
# TRUST_PROXY_HEADERS=false

# --- Step C: email (manual test digests only; nothing is sent automatically) ---
# Resend API key (https://resend.com/api-keys). Use a key with "Sending access" only.
# SECRET: keep it in backend/.env, never commit it.
RESEND_API_KEY=
# Master switch. No email is sent unless this is true.
EMAIL_ENABLED=false
# Comma-separated addresses that may receive test digests. A test digest goes to
# the signed-in account's own email, and only if that address is listed here.
EMAIL_TEST_RECIPIENTS=
# Resend's test sender only delivers to the email you signed up to Resend with.
# Sending to anyone else needs a domain you own, verified in Resend.
# EMAIL_FROM=Healthcare Research Agent <onboarding@resend.dev>
# Test sends per user per hour (in memory, resets on restart).
# EMAIL_TEST_SENDS_PER_HOUR=5
# EMAIL_TIMEOUT_SECONDS=15

# --- Step D: scheduled digests (both OFF by default) ---
# off       = nothing is scheduled, built or sent
# dry_run   = digests are built and stored, never sent
# allowlist = real emails, ONLY to EMAIL_TEST_RECIPIENTS (also needs EMAIL_ENABLED=true
#             and RESEND_API_KEY); everyone else is skipped. There is no unrestricted mode.
# DIGEST_DELIVERY_MODE=off
# Run the scheduler loop inside the backend. `python -m app.jobs.digests run-once` works either way.
# DIGEST_SCHEDULER_ENABLED=false
# DIGEST_TICK_SECONDS=60
# DIGEST_MAX_PER_TICK=10
# Gemini requests per tick (one per digest); scheduled digests count only against AI_DAILY_LIMIT_TOTAL.
# DIGEST_MAX_AI_CALLS_PER_TICK=5
# Dry runs use abstract excerpts unless this is true (saves Gemini quota).
# DIGEST_DRY_RUN_USE_AI=false
# DIGEST_LEASE_SECONDS=600
# DIGEST_MAX_ATTEMPTS=4
# Retries with the same idempotency key only within this many hours (Resend keeps keys 24 h).
# DIGEST_SAFE_RETRY_HOURS=23

# --- Step D: links in scheduled emails ---
# Frontend address (the /unsubscribe confirmation page and "Manage your subscriptions").
# PUBLIC_APP_URL=http://localhost:3000
# Backend address (the one-click unsubscribe endpoint). Mail apps only offer one-click
# unsubscribe for https:// addresses on email from a DKIM-verified domain, so locally
# (http://localhost) only the List-Unsubscribe header is sent, without List-Unsubscribe-Post.
# PUBLIC_API_URL=http://localhost:8010
# Invalid unsubscribe tokens allowed per IP per window before 429 (in memory).
# UNSUBSCRIBE_IP_MAX_INVALID=30
# UNSUBSCRIBE_IP_WINDOW_SECONDS=600
#
# Operations guide: docs/SCHEDULED_DIGESTS.md
