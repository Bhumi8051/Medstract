# Copy to .env.local and adjust. .env.local is git-ignored.
#
# URL of the FastAPI backend. NEXT_PUBLIC_ variables are embedded in the
# browser bundle, so NEVER put API keys or other secrets here; those belong
# in backend/.env only.
#
# Optional: the code already defaults to http://localhost:8010, this project's
# backend port. Set it only if the backend runs somewhere else. Restart
# `npm run dev` after changing it; the value is read when the server starts.
NEXT_PUBLIC_API_URL=http://localhost:8010
